generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/projects-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  content   String
  tags      String[] @default([])
  demoUrl   String
  githubUrl String
  createdAt DateTime @default(now())
}
